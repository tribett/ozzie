{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx"
  },
  "include": [
    "core/**/*.ts",
    "product/**/*.ts",
    "product/web/src/**/*.tsx",
    "product/desktop/src/**/*.tsx"
  ]
}
