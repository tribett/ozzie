{
  "name": "ozzie",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint core product",
    "dev": "vite --config product/web/vite.config.ts product/web",
    "build:web": "vite build --config product/web/vite.config.ts product/web",
    "build:desktop-ui": "vite build --config product/desktop/vite.config.ts product/desktop",
    "build:desktop": "cd product/desktop && tauri build --bundles app --no-sign",
    "build:mcp": "vite build --config core/mcp/vite.config.ts",
    "test:native": "cargo +1.99.1 test --manifest-path core/native-auth/Cargo.toml --locked",
    "test:keychain": "cargo +1.99.1 test --manifest-path core/native-auth/Cargo.toml --locked --test keychain_canary -- --ignored"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@tauri-apps/api": "2.12.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
