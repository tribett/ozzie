{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ozzie",
  "version": "0.8.1",
  "identifier": "church.ozzie.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build:share && pnpm build:shortcuts && pnpm build:desktop-ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ozzie by FlockConnect",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false,
        "devtools": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCOTFEODlEMUUwMkM4M0EKUldRNnlBSWVuZGlSK3ltRlZUUFF3VGluM1ZpNndGQkpVbmxiSXJOQThKeUhwMmZ5N1hqUTNXcjkK",
      "endpoints": [
        "https://github.com/tribett/ozzie/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/ozzie-calendar",
      "binaries/ozzie-card-reader",
      "binaries/ozzie-listen",
      "binaries/ozzie-share",
      "binaries/ozzie-shortcuts"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist",
      "files": {
        "Extensions/OzzieIntents.appex": "binaries/OzzieIntents.appex"
      }
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
