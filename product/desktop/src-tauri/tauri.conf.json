{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ozzie",
  "version": "0.1.0",
  "identifier": "church.ozzie.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop-ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ozzie by FlockConnect",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false,
        "devtools": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/ozzie-card-reader",
      "binaries/ozzie-listen"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
